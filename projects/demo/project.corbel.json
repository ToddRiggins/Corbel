{
  "name": "Demo",
  "main_scene": "res://main.cscene",
  "autoload": {
    "Score": "res://score.ts"
  },
  "window": {
    "width": 1280,
    "height": 720
  },
  "input": {
    "spin_fast": {
      "deadzone": 0.2,
      "events": [
        {
          "key": "Space"
        },
        {
          "key": "W",
          "alt": true
        }
      ]
    },
    "spin_slow": {
      "deadzone": 0.2,
      "events": [
        {
          "key": "X"
        },
        {
          "mouse_button": 1
        }
      ]
    }
  }
}
